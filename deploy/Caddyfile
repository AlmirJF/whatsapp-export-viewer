{$SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	log {
		output stdout
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers>X-Forwarded-For delete
			request>headers>Cf-Connecting-Ip delete
			wrap json
		}
	}

	@notSitemaps not path /sitemap.xml /sitemap-pages.xml
	log_skip @notSitemaps

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com"
	}

	request_body {
		max_size 1MB
	}

	@metrics {
		method POST
		path /__metrics/visit /__metrics/import-started /__metrics/import-succeeded /__metrics/import-failed
	}

	handle @metrics {
		reverse_proxy metrics:8080
	}

	@contact {
		method POST
		path /__contact
	}

	handle @contact {
		reverse_proxy metrics:8080
	}

	handle {
		reverse_proxy app:3000
	}
}

http://:9180 {
	encode zstd gzip
	reverse_proxy metrics:8080
}
